# Database Configuration
# Not required for local development — the site uses SQLite by default.
# Only fill these in if you've switched DATABASES to MySQL in project/settings.py
DB_NAME=writing_feedback
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306

# Email Configuration
# Not required to run the site — if left blank, emails just won't send
# (submissions/reviews still work, you'll see a warning message instead).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_16_character_app_password
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=your_email@gmail.com

# Optional — without this, essays get a placeholder/fallback score instead
# of real AI feedback. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional — used by project/settings.py; safe to leave as-is for local dev
DEBUG=true
SECRET_KEY=dev-secret-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
